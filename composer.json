{
  "name": "sarcio/shim",
  "description": "Sarcio PHP shim — Laravel middleware and Symfony kernel listener over the v1 sidecar protocol",
  "type": "library",
  "license": "BUSL-1.1",
  "homepage": "https://www.sarcio.io",
  "authors": [
    {
      "name": "Dayne Mentier",
      "email": "releases@sarcio.io",
      "homepage": "https://www.sarcio.io"
    }
  ],
  "support": {
    "docs": "https://www.sarcio.io/docs",
    "email": "support@sarcio.io",
    "issues": "https://github.com/sarcioai/sarcio-php-shim/issues",
    "source": "https://github.com/sarcioai/sarcio-php-shim"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "illuminate/http": "^10 || ^11",
    "symfony/http-kernel": "^6 || ^7"
  },
  "suggest": {
    "ext-apcu": "Shared route-set caching across PHP-FPM workers (recommended)",
    "illuminate/http": "Laravel middleware adapter",
    "symfony/http-kernel": "Symfony kernel-listener adapter"
  },
  "autoload": {
    "psr-4": {
      "Sarcio\\Shim\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sarcio\\Shim\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
